# Endereco INTERNO do Agente de FAQ Municipal (repo agente_inteligente).
# Lido em runtime pelas rotas /api/chat/* (server-side; nao vai para o navegador).
# Prefira a rede interna do Coolify, sem passar pelo Traefik publico.
AGENTE_API_URL=http://faq-cache:8000

# Painel de ocorrências (/admin/ocorrencias). Sem este token (mín. 16
# caracteres) o painel fica desativado. Gere com: openssl rand -hex 24
OCORRENCIAS_ADMIN_TOKEN=

# Pasta onde as ocorrências e mídias são gravadas (volume persistente).
# No Docker o padrão já é /app/data.
# DATA_DIR=/app/data
