# Endereco INTERNO do Agente de FAQ Municipal (repo agente_inteligente).
# Lido em runtime pelas rotas /api/chat/* (server-side; nao vai para o navegador).
# Prefira a rede interna do Coolify, sem passar pelo Traefik publico.
AGENTE_API_URL=http://faq-cache:8000

# Segredo compartilhado com o agente (ASK_TOKEN no agente): só o hub consegue
# perguntar. Gere um valor longo e aleatório e use o mesmo nos dois lados.
AGENTE_TOKEN=

# Limites de perguntas ao assistente por IP (proteção contra robôs).
CHAT_LIMITE_MINUTO=5
CHAT_LIMITE_DIA=40
